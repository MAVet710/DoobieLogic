# Shared service authentication. Use the same value in Buyer Dashboard.
DOOBIE_API_KEY=replace-with-a-long-random-service-key

# Required for persistent production licenses and API keys.
DATABASE_URL=postgresql://user:password@host:5432/doobielogic?sslmode=require
DOOBIE_BACKEND_MODE=postgres

# Protects DoobieLogic administration endpoints.
ADMIN_API_KEY=replace-with-a-different-long-random-admin-key

# Optional: require login for the standalone Streamlit copilot.
DOOBIE_REQUIRE_LOGIN=false
# DOOBIE_ADMIN_USERNAME=admin
# DOOBIE_ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-hash

# Optional local storage paths used only when no PostgreSQL URL is configured.
DOOBIE_LICENSE_STORE=data/license_store.json
DOOBIE_KEY_DB=data/key_store.db
